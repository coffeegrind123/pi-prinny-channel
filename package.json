{
  "name": "pi-prinny-channel",
  "version": "0.1.0",
  "description": "Matrix channel for pi — talk to a pi session, and the local model behind it, from any Matrix client",
  "keywords": [
    "pi-package",
    "pi",
    "matrix",
    "channel",
    "prinny",
    "messaging"
  ],
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare-runtime": "node server/bin/prinny-channel.mjs --prepare",
    "lint": "for file in extensions/index.ts src/*.ts tests/*.test.ts; do node --check \"$file\"; done && node --check server/bin/prinny-channel.mjs",
    "test": "node --experimental-strip-types --test --test-timeout=90000 tests/*.test.ts",
    "test:unit": "node --experimental-strip-types --test --test-timeout=90000 --test-skip-pattern=\"extension end to end\" tests/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test --test-timeout=90000 tests/extension-e2e.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "extensions"
    ],
    "skills": [
      "skills"
    ]
  }
}
